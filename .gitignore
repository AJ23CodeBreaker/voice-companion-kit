node_modules/

# Secrets. .dev.vars is the local secret file wrangler reads; the .example
# beside it is the one that gets committed.
.dev.vars
*.key
secrets*.json

# Generated from personas/*.txt at build time. Committing it means the .txt
# files stop being the single source of truth and the two drift.
worker/src/personas.generated.ts

# Local wrangler dev state — a real SQLite database holding whatever you said
# to the thing while testing.
.wrangler/

# Eval output. Contains full transcripts.
worker/eval/results/

.DS_Store
Thumbs.db
